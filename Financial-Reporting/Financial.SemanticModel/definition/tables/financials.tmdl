table financials
	lineageTag: e8866066-e7ad-4c5b-b040-515abf3e8a7c

	measure 'Net Sales' = SUM ( financials[Sales] )
		formatString: \$#,0
		displayFolder: KPIs
		lineageTag: 6f1c2a10-3b7e-4c1a-9e51-0a8d4b2f7c01

	measure 'Gross Profit' = SUM ( financials[Profit] )
		formatString: \$#,0
		displayFolder: KPIs
		lineageTag: 6f1c2a10-3b7e-4c1a-9e51-0a8d4b2f7c02

	measure 'Profit Margin' = DIVIDE ( [Gross Profit], [Net Sales] )
		formatString: 0.0%
		displayFolder: KPIs
		lineageTag: 6f1c2a10-3b7e-4c1a-9e51-0a8d4b2f7c03

	measure 'Units Sold Total' = SUM ( financials[Units Sold] )
		formatString: #,0
		displayFolder: KPIs
		lineageTag: 6f1c2a10-3b7e-4c1a-9e51-0a8d4b2f7c04

	measure 'Discount Rate' = DIVIDE ( SUM ( financials[Discounts] ), SUM ( financials[Gross Sales] ) )
		formatString: 0.0%
		displayFolder: KPIs
		lineageTag: 6f1c2a10-3b7e-4c1a-9e51-0a8d4b2f7c05

	column 'Month Start' = DATE ( YEAR ( financials[Date] ), MONTH ( financials[Date] ), 1 )
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: 6f1c2a10-3b7e-4c1a-9e51-0a8d4b2f7c06
		summarizeBy: none

		annotation SummarizationSetBy = User

