{
  "name": "Executive Clean",
  "dataColors": ["#1E3A5F", "#2A9D8F", "#8DB3D9", "#E9C46A", "#E76F51", "#6C7A89", "#B8C4D0", "#264653"],
  "background": "#FFFFFF",
  "foreground": "#1F2937",
  "tableAccent": "#1E3A5F",
  "good": "#2A9D8F",
  "neutral": "#E9C46A",
  "bad": "#E76F51",
  "maximum": "#1E3A5F",
  "center": "#8DB3D9",
  "minimum": "#EEF3F8",
  "textClasses": {
    "callout": { "fontSize": 30, "fontFace": "Segoe UI Semibold", "color": "#111827" },
    "title": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#111827" },
    "header": { "fontSize": 11, "fontFace": "Segoe UI Semibold", "color": "#374151" },
    "label": { "fontSize": 10, "fontFace": "Segoe UI", "color": "#6B7280" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E6E9EF" } }, "radius": 12, "width": 1 }],
        "dropShadow": [{ "show": false }],
        "padding": [{ "top": 14, "bottom": 14, "left": 18, "right": 18 }],
        "title": [{
          "show": true,
          "fontColor": { "solid": { "color": "#111827" } },
          "fontSize": 12,
          "fontFamily": "Segoe UI Semibold",
          "alignment": "left"
        }],
        "categoryAxis": [{
          "showAxisTitle": false,
          "gridlineShow": false,
          "labelColor": { "solid": { "color": "#6B7280" } },
          "fontSize": 9
        }],
        "valueAxis": [{
          "showAxisTitle": false,
          "gridlineShow": true,
          "gridlineColor": { "solid": { "color": "#EEF0F4" } },
          "gridlineStyle": "solid",
          "labelColor": { "solid": { "color": "#9CA3AF" } },
          "fontSize": 9
        }],
        "legend": [{
          "show": true,
          "position": "TopRight",
          "labelColor": { "solid": { "color": "#6B7280" } },
          "fontSize": 9
        }],
        "labels": [{ "color": { "solid": { "color": "#374151" } }, "fontSize": 9 }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F4F6F9" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#F4F6F9" } }, "transparency": 0 }]
      }
    },
    "card": {
      "*": {
        "title": [{ "show": false }],
        "labels": [{ "color": { "solid": { "color": "#111827" } }, "fontSize": 30, "fontFamily": "Segoe UI Semibold" }],
        "categoryLabels": [{ "show": true, "color": { "solid": { "color": "#6B7280" } }, "fontSize": 11, "fontFamily": "Segoe UI" }]
      }
    },
    "textbox": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": false }],
        "title": [{ "show": false }],
        "padding": [{ "top": 0, "bottom": 0, "left": 0, "right": 0 }]
      }
    },
    "slicer": {
      "*": {
        "title": [{ "show": false }],
        "padding": [{ "top": 6, "bottom": 6, "left": 12, "right": 12 }],
        "header": [{ "show": true, "fontColor": { "solid": { "color": "#6B7280" } }, "textSize": 9, "fontFamily": "Segoe UI" }],
        "items": [{ "fontColor": { "solid": { "color": "#111827" } }, "textSize": 10, "fontFamily": "Segoe UI" }]
      }
    },
    "tableEx": {
      "*": {
        "grid": [{
          "gridVertical": false,
          "gridHorizontal": true,
          "gridHorizontalColor": { "solid": { "color": "#EEF0F4" } },
          "outlineColor": { "solid": { "color": "#FFFFFF" } },
          "rowPadding": 6,
          "textSize": 10
        }],
        "columnHeaders": [{
          "fontColor": { "solid": { "color": "#6B7280" } },
          "backColor": { "solid": { "color": "#FFFFFF" } },
          "fontFamily": "Segoe UI Semibold",
          "outline": "Bottom only"
        }],
        "values": [{
          "fontColorPrimary": { "solid": { "color": "#1F2937" } },
          "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
          "fontColorSecondary": { "solid": { "color": "#1F2937" } },
          "backColorSecondary": { "solid": { "color": "#FFFFFF" } }
        }],
        "total": [{
          "fontColor": { "solid": { "color": "#111827" } },
          "backColor": { "solid": { "color": "#F7F8FA" } },
          "fontFamily": "Segoe UI Semibold"
        }]
      }
    }
  }
}
